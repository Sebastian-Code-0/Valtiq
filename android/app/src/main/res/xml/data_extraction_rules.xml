<?xml version="1.0" encoding="utf-8"?>
<!-- Valtiq no permite que Android copie sus datos financieros fuera del
     dispositivo. El único respaldo soportado es el manual (Ajustes →
     Copia de seguridad). Sin estas reglas, Android 12+ sigue permitiendo
     la transferencia D2D aunque allowBackup="false". -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
