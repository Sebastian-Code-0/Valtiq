<?xml version="1.0" encoding="utf-8"?>
<!-- Widget de resumen (deudas o préstamos). Los textos los pone
     ResumenWidgets.kt con lo que deja Valtiq al abrirse. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_fondo"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/titulo"
        android:text="Valtiq"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:letterSpacing="0.08"
        android:maxLines="1"
        android:textAllCaps="true"
        android:textColor="@color/widget_texto_sec"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/total"
        android:text="—"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:fontFamily="monospace"
        android:maxLines="1"
        android:textColor="@color/widget_texto"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/cantidad"
        android:text="Abre Valtiq para ver tus datos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:maxLines="1"
        android:textColor="@color/widget_texto_sec"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/fila_0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/nombre_0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_texto_sec"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/monto_0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:textColor="@color/widget_texto"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/fila_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/nombre_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_texto_sec"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/monto_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:textColor="@color/widget_texto"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/fila_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/nombre_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_texto_sec"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/monto_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:textColor="@color/widget_texto"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/mas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/widget_texto_sec"
        android:textSize="12sp"
        android:visibility="gone" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/actualizado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="@color/widget_texto_sec"
        android:textSize="10sp" />
</LinearLayout>
