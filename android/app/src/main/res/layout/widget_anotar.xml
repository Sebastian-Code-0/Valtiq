<?xml version="1.0" encoding="utf-8"?>
<!-- Widget "Anotar gasto": tarjeta con un círculo vino con "+", el nombre y
     un ejemplo de cómo escribir. En el ancho mínimo Android 12+ usa
     widget_anotar_compacto.xml. Solo vistas que acepta Android en widgets
     (LinearLayout, ImageView, TextView). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_fondo"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingEnd="14dp">

    <ImageView
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/widget_circulo"
        android:contentDescription="@null"
        android:padding="9dp"
        android:src="@drawable/widget_mas" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:autoSizeMaxTextSize="15sp"
            android:autoSizeMinTextSize="11sp"
            android:autoSizeTextType="uniform"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:text="@string/widget_anotar_nombre"
            android:textColor="@color/widget_texto"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:text="@string/widget_anotar_ejemplo"
            android:textColor="@color/widget_texto_sec"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
