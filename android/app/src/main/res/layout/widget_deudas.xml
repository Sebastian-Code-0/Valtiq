<?xml version="1.0" encoding="utf-8"?>
<!-- Widget de deudas activas: igual que la tarjeta de Inicio (ícono
     y título, el total y una nota). Los textos los pone ResumenWidgets.kt.
     Solo vistas que acepta Android en widgets: LinearLayout, ImageView y
     TextView (una View suelta hace que el widget no se pueda agregar). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_fondo"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="14dp"
    android:paddingEnd="18dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/icono"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_icono_deudas"
            android:tint="@color/widget_alerta" />

        <TextView
            android:id="@+id/titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_deudas_nombre"
            android:textColor="@color/widget_texto_sec"
            android:textSize="12.5sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/total"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:autoSizeMaxTextSize="26sp"
        android:autoSizeMinTextSize="14sp"
        android:autoSizeTextType="uniform"
        android:fontFamily="monospace"
        android:maxLines="1"
        android:text="—"
        android:textColor="@color/widget_texto"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/nota"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="@string/widget_abrir_valtiq"
        android:textColor="@color/widget_texto_sec"
        android:textSize="12sp" />
</LinearLayout>
