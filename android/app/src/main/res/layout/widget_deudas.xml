<?xml version="1.0" encoding="utf-8"?>
<!-- Widget de deudas: una
     fila del mismo tamaño que "Anotar gasto" (ícono en un aro + título + total).
     Los textos los pone ResumenWidgets.kt. Solo vistas que acepta Android en
     widgets: LinearLayout, ImageView y TextView (una View suelta hace que el
     widget no se pueda agregar). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_fondo"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingEnd="16dp">

    <ImageView
        android:id="@+id/icono"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/widget_circulo_borde"
        android:contentDescription="@null"
        android:padding="9dp"
        android:src="@drawable/widget_icono_deudas"
        android:tint="@color/widget_alerta" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_deudas_nombre"
            android:textColor="@color/widget_texto_sec"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/total"
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:autoSizeMaxTextSize="17sp"
            android:autoSizeMinTextSize="9sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="monospace"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:text="—"
            android:textColor="@color/widget_texto"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
